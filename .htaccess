# Set CI_ENV=development for local hostnames so PHP errors are visible.
# Production hostnames don't match these patterns and inherit the
# 'production' default defined in index.php.
#
# To temporarily expose errors on a live staging host, add its hostname
# pattern here. REMOVE it again before going truly public — running
# production with display_errors=On leaks stack traces to visitors.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Host "\.test$"                   CI_ENV=development
    SetEnvIfNoCase Host "^localhost"                CI_ENV=development
    SetEnvIfNoCase Host "^127\.0\.0\.1"             CI_ENV=development
    SetEnvIfNoCase Host "^\[::1\]"                  CI_ENV=development
</IfModule>

# Block access to sensitive system files, git, sql dumps, environment files
<FilesMatch "^\.|\.(sql|env|json|bak|config|log|md|sh|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable Directory Browsing
Options -Indexes

RewriteEngine On

# Redirect HTTP to HTTPS in production (respecting reverse proxy SSL termination)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^(www\.)?kulacrm\.com [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]
