# ==============================================================================
# KULACRM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (production | development | testing)
CI_ENV=production

# Database Connection Profile (online | default | offline)
CI_DB_GROUP=online

# Database Credentials
DB_HOST=kula-db
DB_PORT=3306
DB_USER=root
DB_PASS=kula_root_pass
DB_NAME=livestock

# Application Encryption Key (Generate via: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;")
ENCRYPTION_KEY=

# Base URL (Optional)
# BASE_URL=https://yourdomain.com
